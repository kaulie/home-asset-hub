# home-asset-hub 运行期配置（复制到 <runtime>/backend/.env；脚本会 source 后 export 给二进制）
# 资源目录：图片/音频/视频/PDF 的扁平文件库（key = 文件名）
ASSET_HUB_DIR=/Users/gaolei/artifact-storage/home-asset-hub/img
# 监听口：电视/小度 的 URL 就是 http://<mac-lan-ip>:8080/<key>，别改
ASSET_HUB_PORT=8080
# 附加监听口（健康检查用；逗号分隔，只绑 ASSET_HUB_EXTRA_HOST=127.0.0.1，不对外）
# 平台登记的服务端口 ≠ 8080 时，start.sh 会自动把它加到这里 —— 健康检查随便查哪个口都能过。
# off / - / none = 彻底不附加。
# ASSET_HUB_EXTRA_PORTS=4236
# ASSET_HUB_EXTRA_HOST=127.0.0.1
# 对外地址（上传响应里的 url）；不设则按 LAN IP 自动探测
# ASSET_HUB_PUBLIC_BASE=http://192.168.3.84:8080
# mDNS 广告 _ha-img-server._tcp（iOS/Edge 靠它发现资源服务器）；=0 关闭
# ASSET_HUB_MDNS=1
# 兼容现网 img-server 的老变量名（PHOTO_UPLOAD_DIR / PHOTO_PUBLIC_BASE / PHOTO_UPLOAD_PORT 都认）

# ---- 资源管理 v2（不配也能跑，下面是默认值）----
# 上传去重：同 sha256 复用已存在的 key（省空间；同内容重传会把该文件 mtime 顶新，
# 所以 /latest、「最新一张」语义不变）。=0 关闭；单请求可覆盖 ?dedupe=0
# ASSET_HUB_DEDUPE=1
# 定时快照备份：rsync 硬链接增量，保留 N 份；=0 关闭
# ASSET_HUB_BACKUP=1
# 快照根目录，默认 <资源目录>/../backup（与资源目录同盘；异地容灾不在本版）
# ASSET_HUB_BACKUP_DIR=/Users/gaolei/artifact-storage/home-asset-hub/backup
# ASSET_HUB_BACKUP_INTERVAL=24h
# ASSET_HUB_BACKUP_KEEP=7
# 启动时补建 sha256 索引（v1 老文件第一次开机就补上）；=0 关闭
# ASSET_HUB_INDEX_BUILD_ON_START=1
# 保留策略：>0 才开，会**真删**比这个天数更老的资源（Brain 的 assets 引用不会跟着清，
# 开之前先看 POST /api/v1/maintenance/prune 的 dry-run 候选）
# ASSET_HUB_RETENTION_DAYS=0
# ASSET_HUB_RETENTION_INTERVAL=24h
# ASSET_HUB_RETENTION_MAX=200
